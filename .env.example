# Docker Compose carga este archivo al copiarlo a .env en la raiz.
# Valores dummy publicos, solo para pruebas locales. Sustituye TODOS los secretos
# y genera otra pareja Ed25519 antes de usar datos reales o publicar el servidor.
# No subas .env al repositorio.
DJANGO_SECRET_KEY=dummy-local-only-educall-not-for-production-0123456789
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Mexico_City
EDUCALL_PORT=8080
POSTGRES_DB=educall
POSTGRES_USER=educall
POSTGRES_PASSWORD=dummy-local-only-educall-postgres

# La pareja Ed25519 dummy de abajo es valida y coincide, pero es publica e
# insegura: cualquiera puede firmar paquetes con ella. Solo para pruebas.
# Para uso real, genera una pareja siguiendo README.md. Servidor y APK deben
# compartir la misma clave publica; recompila Registro al cambiarla.
#
# PRIVATE: clave privada del servidor, 32 bytes en Base64. No incluir en Android.
# Necesaria para que EduCall Server firme los paquetes .attendance.
ATTENDANCE_SIGNING_PRIVATE_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
#
# PUBLIC: clave publica correspondiente, 32 bytes en Base64 (44 caracteres).
# Necesaria para compilar Registro con Docker y verificar los paquetes firmados.
# Pega solo el valor Base64, sin el prefijo PUBLIC= ni comillas.
# No pegues la clave privada, una clave PEM ni TU_CLAVE_PUBLICA_EN_BASE64.
ATTENDANCE_SIGNING_PUBLIC_KEY=A6EHv/POEL4dcN0Y50vAmWfk1jCbpQ1fHdyGZBJVMbg=
#
# Compilar tras completar PUBLIC y copiar este archivo a .env:
# docker compose -f compose.android.yaml build dial
# docker compose -f compose.android.yaml run --rm --no-deps registro
#
# Una variable de PowerShell tiene prioridad sobre este archivo. Si antes
# definiste una clave de ejemplo, eliminala antes de compilar:
# Remove-Item Env:\ATTENDANCE_SIGNING_PUBLIC_KEY -ErrorAction SilentlyContinue
