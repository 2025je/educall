DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=America/Lima

# Set all PostgreSQL values for production; local development defaults to SQLite.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Base64-encoded raw 32-byte Ed25519 key material. Keep the private key secret.
ATTENDANCE_SIGNING_PRIVATE_KEY=
ATTENDANCE_SIGNING_PUBLIC_KEY=
