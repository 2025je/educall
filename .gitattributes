# Finales de línea LF en el repositorio y en la copia de trabajo, sin importar core.autocrlf.
# Los scripts .sh, Dockerfile y archivos de CI se ejecutan en Linux y requieren LF.
* text=auto eol=lf

# Binarios: Git no debe tocarlos.
*.apk binary
*.aab binary
*.jar binary
*.keystore binary
*.jks binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.zip binary
*.sqlite3 binary

# Scripts de Windows: CRLF. gradlew debe conservar LF para ejecutarse en Linux/macOS.
*.bat text eol=crlf
*.cmd text eol=crlf
gradlew text eol=lf
